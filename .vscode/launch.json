{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch EngineApp",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/EngineApp.exe",
      "cwd": "${workspaceFolder}/build",
      "externalConsole": false,
      "stopAtEntry": false,
      "MIMode": "gdb",
      "miDebuggerPath": "gdb.exe",
      "environment": [
        {
          "name": "PATH",
          "value": "${workspaceFolder}/build;${env:PATH}"
        }
      ],
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}
